            "source": {
              "expression": [
                "let",
                "  Source = Excel.Workbook(File.Contents(\"C:\\GIRISH\\CODE\\GitHubDesktop\\Power-BI-File-Formats\\DataSource\\AdventureWorks Sales.xlsx\"), null, true),",
                "  #\"Navigation 1\" = Source{[Item = \"Date\", Kind = \"Sheet\"]}[Data],",
                "  #\"Promoted headers\" = Table.PromoteHeaders(#\"Navigation 1\", [PromoteAllScalars = true]),",
                "  #\"Changed column type\" = Table.TransformColumnTypes(#\"Promoted headers\", {{\"DateKey\", Int64.Type}, {\"Date\", type date}, {\"Fiscal Year\", type text}, {\"Fiscal Quarter\", type text}, {\"Month\", type date}, {\"Full Date\", type date}, {\"MonthKey\", Int64.Type}}, \"en-US\")",
                "in",
                "  #\"Changed column type\""
              ],
              "type": "m"
            }
          }
        ]
